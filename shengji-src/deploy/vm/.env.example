# Copy to .env next to compose.yaml and fill in.

# Hostname that points at this VM (Caddy gets a certificate for it).
DOMAIN=knowingant-shengji.duckdns.org

# OAuth web client ID from the Google Cloud console; the only way to sign in.
GOOGLE_CLIENT_ID=REPLACE_ME.apps.googleusercontent.com

# Origin of the page that talks to this backend (comma-separated if several).
CORS_ALLOWED_ORIGINS=https://knowingant.github.io
