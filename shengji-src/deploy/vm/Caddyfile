# HTTPS for the shengji backend. Caddy gets and renews the Let's Encrypt
# certificate for $DOMAIN by itself; ports 80 and 443 must be reachable and
# DNS for $DOMAIN must point at this machine before the first start.
#
# The backend uses the Fly-Client-IP header for per-IP rate limits when
# TRUST_PROXY_HEADERS=1. header_up *replaces* any value the client sent, so
# it cannot be spoofed. Websocket upgrades are proxied automatically.
{$DOMAIN} {
	encode zstd gzip
	reverse_proxy shengji:3030 {
		header_up Fly-Client-IP {remote_host}
	}
}
